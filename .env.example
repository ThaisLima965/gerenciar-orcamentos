PORT=3000
NODE_ENV=development
JWT_SECRET=seu_jwt_secret_super_seguro
JWT_EXPIRES_IN=8h
COOKIE_SECRET=seu_cookie_secret_super_seguro
DB_PATH=./database/database.sqlite
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require

# Configurações de E-mail Corporativo (SMTP / Opcional para envio real de e-mails)
# Se não preenchido, os e-mails serão gerados e exibidos no log/console com link seguro
APP_URL=http://localhost:3000
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=suporte@empresa.com
SMTP_PASS=sua_senha_smtp
SMTP_SECURE=false
SMTP_FROM="TKE Suporte Corporativo" <suporte@empresa.com>

# ==========================================
# Gateway de SMS Corporativo (Twilio / Zenvia)
# ==========================================
# Opção 1: Twilio (Global / Recomendado)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=seu_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui
TWILIO_PHONE_NUMBER=+1234567890

# Opção 2: Zenvia (Nacional Brasil)
# SMS_PROVIDER=zenvia
# ZENVIA_API_TOKEN=seu_token_zenvia_aqui
# ZENVIA_FROM=TKE


